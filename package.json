{
  "name": "agenticleaf",
  "version": "1.0.0",
  "description": "Agent-first LaTeX editor and compilation engine based on Overleaf",
  "main": "src/index.js",
  "bin": {
    "agenticleaf": "./bin/agenticleaf.js"
  },
  "scripts": {
    "start": "node bin/agenticleaf.js serve",
    "serve": "node bin/agenticleaf.js serve",
    "mcp": "node bin/agenticleaf.js mcp",
    "test": "NODE_OPTIONS=\"-r /home/server/.local/lib/clean-exit.js\" node --test test/**/*.test.js",
    "test:e2e": "NODE_OPTIONS=\"-r /home/server/.local/lib/clean-exit.js\" node test/verify-e2e.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "archiver": "^8.0.0",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "pdf-parse": "^2.4.5",
    "unzipper": "^0.12.5"
  }
}
